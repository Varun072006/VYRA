{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VyraProtocolMessage",
  "type": "object",
  "required": ["type", "sessionId", "timestamp", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "session.start",
        "session.end",
        "device.status",
        "ocr.result",
        "caption.update",
        "summary.update",
        "context.created",
        "context.updated",
        "memory.save",
        "memory.delete",
        "task.created",
        "deadline.created",
        "note.created",
        "query.ask",
        "query.response"
      ]
    },
    "sessionId": {
      "type": "string"
    },
    "timestamp": {
      "type": "integer"
    },
    "payload": {
      "type": "object"
    }
  },
  "definitions": {
    "DeviceStatusPayload": {
      "type": "object",
      "required": ["npu", "qnn", "ramFreeGB", "batteryPct", "thermalState"],
      "properties": {
        "npu": { "type": "string", "enum": ["ACTIVE", "IDLE", "OFFLINE"] },
        "qnn": { "type": "string", "enum": ["HTP", "CPU_FALLBACK", "DISABLED"] },
        "ramFreeGB": { "type": "number" },
        "batteryPct": { "type": "integer" },
        "thermalState": { "type": "string", "enum": ["NOMINAL", "FAIR", "SERIOUS", "CRITICAL"] },
        "deviceModel": { "type": "string" }
      }
    },
    "ContextPayload": {
      "type": "object",
      "required": ["id", "type", "title", "content", "confidence", "sourceType"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["FACT", "TASK", "DEADLINE", "DECISION", "PERSON", "LOCATION", "WARNING"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceType": { "type": "string", "enum": ["CAMERA", "VOICE", "NOTE", "MEETING"] },
        "date": { "type": "string" },
        "action": { "type": "string" },
        "owner": { "type": "string" },
        "relatedEntities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "MemoryPayload": {
      "type": "object",
      "required": ["id", "title", "summary", "sourceType", "createdAt", "userSaved"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["CAMERA", "VOICE", "NOTE", "MEETING"] },
        "rawSourceRef": { "type": "string" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "entities": { "type": "array", "items": { "type": "string" } },
        "tasks": { "type": "array" },
        "deadlines": { "type": "array" },
        "decisions": { "type": "array" },
        "userSaved": { "type": "boolean" },
        "embedding": { "type": "array", "items": { "type": "number" } }
      }
    }
  }
}
